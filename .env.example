# Bu dosyanın adını .env yap ve değerleri doldur. .env dosyası GitHub'a YÜKLENMEZ.

# Yapay zeka (Ollama). 16 GB RAM için önerilen: qwen3:8b. Daha hızlı istersen qwen2.5:7b.
OLLAMA_ADRES=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# İkinci yapay zeka: Google Gemini (ücretsiz katman; isteğe bağlı). Ollama yazar, Gemini denetler.
# Anahtar: https://aistudio.google.com/apikey  — boşsa veya kota dolarsa sistem yalnızca Ollama ile çalışır.
GEMINI_API_ANAHTARI=
GEMINI_MODEL=gemini-3.5-flash

# Ücretsiz stok video (ikisi de isteğe bağlı; yoksa görüntüler yapay zekayla üretilir)
# https://www.pexels.com/api/
PEXELS_API_ANAHTARI=
# https://pixabay.com/api/docs/  (giriş yapınca anahtar sayfada görünür)
PIXABAY_API_ANAHTARI=

# YouTube trendleri için (isteğe bağlı ama önerilir). Google Cloud > API'ler > Kimlik bilgileri > API anahtarı
YOUTUBE_API_ANAHTARI=

# Günde en fazla kaç video yüklensin (YouTube kotası günde yaklaşık 6 yüklemeye izin verir)
GUNLUK_YUKLEME_SINIRI=6

# Onay masası. Telefondan aynı Wi-Fi'da bakmak için 0.0.0.0 yap.
ONAY_ADRESI=127.0.0.1
ONAY_PORTU=8765
