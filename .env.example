# Bu dosyanın adını .env yap ve değerleri doldur. .env dosyası GitHub'a YÜKLENMEZ.

# Yapay zeka (Ollama). 16 GB RAM için önerilen: qwen2.5:7b. Çok yavaşsa qwen2.5:3b yap.
OLLAMA_ADRES=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Ücretsiz stok video: https://www.pexels.com/api/  (zorunlu)
PEXELS_API_ANAHTARI=

# YouTube trendleri için (isteğe bağlı ama önerilir). Google Cloud > API'ler > Kimlik bilgileri > API anahtarı
YOUTUBE_API_ANAHTARI=

# Günde en fazla kaç video yüklensin (YouTube kotası günde yaklaşık 6 yüklemeye izin verir)
GUNLUK_YUKLEME_SINIRI=6

# Onay masası. Telefondan aynı Wi-Fi'da bakmak için 0.0.0.0 yap.
ONAY_ADRESI=127.0.0.1
ONAY_PORTU=8765
